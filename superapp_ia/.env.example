# Copier ce fichier en .env (copy .env.example .env) puis adapter les valeurs.

# --- Django ---
DJANGO_SECRET_KEY=change_moi_une_longue_chaine_aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Sécurité Laravel -> Django (en-tête X-Service-Token) ---
# DOIT être identique à DJANGO_IA_INTERNAL_KEY dans backend/.env
LARAVEL_SHARED_TOKEN=change_moi_cle_partagee_avec_laravel

# --- Base MySQL (la même que Laravel, voir backend/.env) ---
DB_NAME=backendpff
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- IA locale (Ollama) ---
OLLAMA_URL=http://localhost:11434
# Un seul modèle léger pour tout (2,7 Go de RAM) : indispensable sur un PC de 8-10 Go.
# Sur un PC de 16 Go ou plus : OLLAMA_MODEL=mistral:7b-instruct (veille mieux rédigée).
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_MODEL_RAPIDE=qwen3.5:2b
# La veille partage le modèle du chat : elle le garde chargé et laisse des cœurs libres.
OLLAMA_VEILLE_KEEP_ALIVE=30m
OLLAMA_VEILLE_NUM_THREAD=3

# --- Tavily (recherche web) : clé gratuite sur https://app.tavily.com ---
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
TAVILY_MONTHLY_LIMIT=1000
# Crédits gardés pour le chatbot et l'orientation (la veille s'arrête avant)
TAVILY_RESERVE_INTERACTIF=200
TAVILY_TIMEOUT_SECONDES=8

# --- Redis (broker Celery + cache des réponses) ---
REDIS_URL=redis://localhost:6379/0
CACHE_REPONSE_TTL_HEURES=24
CACHE_ORIENTATION_TTL_JOURS=7

# --- Chatbot : budget de temps total (doit rester < DJANGO_IA_TIMEOUT de Laravel) ---
CHAT_TIMEOUT_SECONDES=25

# --- Veille automatique (Celery Beat) ---
VEILLE_INTERVAL_HOURS=2
# Fréquence quand la part « veille » du quota Tavily est épuisée
VEILLE_INTERVAL_REDUIT_HOURS=6
VEILLE_UNIVERSITES_INTERVALLE_SECONDES=86400
VEILLE_ACTUALITES_AGE_MAX_JOURS=21
VEILLE_ACTUALITES_RETENTION_JOURS=30
VEILLE_OFFRES_AGE_MAX_JOURS=30

# --- RAG (recherche dans les documents) ---
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=3
# 0 au premier lancement (téléchargement du modèle d'embeddings), puis 1 (hors-ligne)
HF_HUB_OFFLINE=0

# Chatbot à outils Google Gemini (offre gratuite, clé sur https://aistudio.google.com avec un compte Gmail personnel)
# Sans clé, le chatbot local (règles + Ollama) répond seul.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_SECOURS=gemini-flash-lite-latest
