APP_NAME=Ndimbeul-Etudiant
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dakar
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de données MySQL 8+ (CDC §9) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=superapp
DB_USERNAME=superapp_user
DB_PASSWORD=change_moi

# --- Cache / Sessions / Queue ---
# Redis recommandé pour rester cohérent avec Celery côté Django (CDC §9 "Redis + Celery").
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Service Django IA (interne, jamais exposé publiquement) ---
DJANGO_IA_BASE_URL=http://django-ia:8000
DJANGO_IA_INTERNAL_KEY=change_moi_cle_partagee_avec_django
DJANGO_IA_TIMEOUT=30

# --- Frontend Flutter (deep-link réinitialisation mot de passe) ---
FRONTEND_RESET_PASSWORD_URL=https://app.superapp.sn/reset-password

# --- CORS (Flutter Web) ---
CORS_ALLOWED_ORIGINS=http://localhost:5000,https://app.superapp.sn

# --- Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5000,127.0.0.1
SANCTUM_TOKEN_EXPIRATION=

# --- Email (réinitialisation mot de passe, alertes) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@superapp.sn"
MAIL_FROM_NAME="${APP_NAME}"

# --- Documentation Swagger (L5-Swagger) ---
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000/api
